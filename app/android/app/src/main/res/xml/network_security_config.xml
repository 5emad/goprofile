<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, and only system certificate authorities: certificates a user or
     another app installs on the phone cannot intercept the app's traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
